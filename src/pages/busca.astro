---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout titulo="Buscar" secao="busca">
  <link slot="head" href={url('/pagefind/pagefind-ui.css')} rel="stylesheet" />
  <h1>Buscar</h1>
  <p class="muted">Procure por uma palavra, passagem bíblica ou autor em todas as aulas e no glossário.</p>
  <div id="busca"></div>
  <noscript>A busca precisa de JavaScript.</noscript>
  <p id="busca-indisponivel" class="muted" hidden>
    O índice de busca é gerado no build (npm run build) e não existe no modo de desenvolvimento.
  </p>
</BaseLayout>

<script is:inline define:vars={{ base }}>
  const s = document.createElement('script');
  s.src = base + '/pagefind/pagefind-ui.js';
  s.onload = () => {
    new PagefindUI({
      element: '#busca',
      showSubResults: true,
      showImages: false,
      autofocus: true,
      translations: {
        placeholder: 'Buscar nas aulas e no glossário',
        zero_results: 'Nada encontrado para [SEARCH_TERM]',
      },
    });
  };
  s.onerror = () => {
    document.getElementById('busca-indisponivel').hidden = false;
  };
  document.head.append(s);
</script>

<style is:global>
  #busca {
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg-elev);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--accent-soft);
    --pagefind-ui-font: var(--sans);
    --pagefind-ui-border-radius: 10px;
    margin-top: 1.25rem;
  }
</style>
