---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAulas, getSeries, nn, urlAula, type Aula, type Serie } from '../../../lib/conteudo';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const series = await getSeries();
  return series.map((serie) => ({ params: { serie: serie.id }, props: { serie } }));
}

const { serie } = Astro.props as { serie: Serie };
const aulas = await getAulas(serie.id);
// Uma aula pode ter várias partes (páginas); aqui ficam agrupadas pelo número.
const porNumero = new Map<number, Aula[]>();
for (const a of aulas) porNumero.set(a.data.numero, [...(porNumero.get(a.data.numero) ?? []), a]);
const { titulo, descricao, periodo, blocos, programa } = serie.data;
---

<BaseLayout titulo={titulo} descricao={descricao} secao="series">
  <p class="migalhas"><a href={url('/')}>Séries</a> /</p>
  <p class="rotulo">{periodo}</p>
  <h1>{titulo}</h1>
  <p>{descricao}</p>

  {
    blocos.map((bloco) => {
      const itens = programa.filter((p) => p.bloco === bloco.id);
      if (itens.length === 0) return null;
      return (
        <section>
          <h2>{bloco.titulo}</h2>
          {bloco.descricao && <p class="muted">{bloco.descricao}</p>}
          <ol class="programa">
            {itens.map((p) => {
              const publicadas = porNumero.get(p.numero) ?? [];
              const aula = publicadas[0];
              if (p.partes) {
                const partes = Array.from({ length: p.partes }, (_, i) =>
                  publicadas.find((a) => a.data.parte === i + 1),
                );
                return (
                  <li class:list={{ planejada: !aula }}>
                    <span class="num">{nn(p.numero)}</span>
                    <span>
                      {aula ? <a href={urlAula(aula)}>{aula.data.titulo}</a> : p.titulo}
                      <span class="partes">
                        {partes.map((parte, i) =>
                          parte ? (
                            <a href={urlAula(parte)}>Parte {i + 1}</a>
                          ) : (
                            <span class="planejada">Parte {i + 1} <small>em breve</small></span>
                          ),
                        )}
                      </span>
                    </span>
                  </li>
                );
              }
              return (
                <li class:list={{ planejada: !aula }}>
                  <span class="num">{nn(p.numero)}</span>
                  {aula ? (
                    <a href={urlAula(aula)}>{aula.data.titulo}</a>
                  ) : (
                    <span>
                      {p.titulo} <small>em breve</small>
                    </span>
                  )}
                </li>
              );
            })}
          </ol>
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .programa { list-style: none; padding: 0; margin: 0; font-family: var(--sans); }
  .programa li { display: flex; gap: 0.9rem; align-items: baseline; padding: 0.6rem 0; border-bottom: 1px solid var(--border); }
  .num { font-variant-numeric: tabular-nums; color: var(--text-muted); font-size: 0.9rem; min-width: 1.6rem; }
  .programa a { font-weight: 600; text-decoration: none; }
  .programa a:hover { text-decoration: underline; }
  .planejada { color: var(--planned); }
  .partes { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.2rem; font-size: 0.88rem; }
  .programa .partes a { font-weight: 500; text-decoration: underline; }
  .planejada small { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; margin-left: 0.4em; }
</style>
