---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descricao?: string;
  secao?: 'inicio' | 'series' | 'glossario' | 'busca';
  largo?: boolean;
}

const { titulo, descricao = 'Conteúdo das aulas da Escola Bíblica Dominical e glossário de termos.', secao, largo = false } = Astro.props;
// Google Analytics 4: só no build de produção, só carrega após consentimento e nunca em localhost.
const GA_ID = 'G-FHQJX2BQL1';
const analytics = import.meta.env.PROD;
const tituloCompleto = titulo ? `${titulo} · EBD` : 'EBD · Aulas e glossário';
const atual = (s: Props['secao']) => (s === secao ? 'page' : undefined);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      // Aplica o tema antes da pintura. data-theme = escolha explícita; data-theme-atual = tema em uso (para o ícone).
      (function () {
        var raiz = document.documentElement;
        var escolhido = null;
        try { escolhido = localStorage.getItem('tema'); } catch (e) {}
        if (escolhido === 'light' || escolhido === 'dark') raiz.dataset.theme = escolhido;
        var escuro = window.matchMedia('(prefers-color-scheme: dark)');
        function atualizar() { raiz.dataset.themeAtual = raiz.dataset.theme || (escuro.matches ? 'dark' : 'light'); }
        atualizar();
        escuro.addEventListener('change', atualizar);
        window.__alternarTema = function () {
          raiz.dataset.theme = raiz.dataset.themeAtual === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('tema', raiz.dataset.theme); } catch (e) {}
          atualizar();
        };
      })();
    </script>
    {
      analytics && (
        <script is:inline define:vars={{ GA_ID }}>
          // Consentimento de cookies (LGPD). 'aceito' | 'recusado' | null (ainda não decidiu).
          (function () {
            var CHAVE = 'consentimento-cookies';
            var local = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
            var carregado = false;
            function ler() { try { return localStorage.getItem(CHAVE); } catch (e) { return null; } }
            function gravar(v) { try { localStorage.setItem(CHAVE, v); } catch (e) {} }
            function carregar() {
              if (carregado || local) return;
              carregado = true;
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { dataLayer.push(arguments); };
              gtag('js', new Date());
              gtag('config', GA_ID);
            }
            function apagarCookiesGA() {
              var dominios = ['', location.hostname, '.' + location.hostname];
              document.cookie.split(';').forEach(function (c) {
                var nome = c.split('=')[0].trim();
                if (nome.indexOf('_ga') !== 0) return;
                dominios.forEach(function (d) {
                  document.cookie = nome + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
                });
              });
            }
            window.__cookies = {
              pendente: function () { return ler() === null; },
              aceitar: function () { gravar('aceito'); carregar(); },
              recusar: function () {
                var tinhaAceito = ler() === 'aceito';
                gravar('recusado');
                apagarCookiesGA();
                if (tinhaAceito && carregado) location.reload();
              },
            };
            if (ler() === 'aceito') carregar();
          })();
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container largo">
        <a class="marca" href={url('/')}>EBD <span>·</span> Aulas</a>
        <nav class="site-nav" aria-label="Principal">
          <a href={url('/')} aria-current={atual('inicio')}>Séries</a>
          <a href={url('/glossario/')} aria-current={atual('glossario')}>Glossário</a>
          <a href={url('/busca/')} aria-current={atual('busca')}>Buscar</a>
          <button class="tema" type="button" aria-label="Alternar tema claro ou escuro" title="Alternar tema claro ou escuro" onclick="window.__alternarTema()">
            <svg class="icone-lua" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icone-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <div class:list={['container', { largo }]}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container largo">
        Material de apoio da Escola Bíblica Dominical. Resumos para estudo pessoal. A Escritura é a única regra de fé e prática.
        {analytics && <> · <button class="link-cookies" type="button" data-abrir-cookies>Cookies</button></>}
      </div>
    </footer>
    {
      analytics && (
        <div class="aviso-cookies" role="dialog" aria-live="polite" aria-label="Aviso de cookies" hidden>
          <p>
            Usamos cookies do Google Analytics apenas para medir as visitas e saber quais conteúdos são mais lidos.
            Eles só são ativados se você aceitar.
          </p>
          <div class="aviso-cookies-botoes">
            <button type="button" class="botao-secundario" data-cookies="recusar">Recusar</button>
            <button type="button" class="botao-primario" data-cookies="aceitar">Aceitar</button>
          </div>
        </div>
        <script is:inline>
          (function () {
            var aviso = document.querySelector('.aviso-cookies');
            if (!aviso || !window.__cookies) return;
            if (window.__cookies.pendente()) aviso.hidden = false;
            aviso.addEventListener('click', function (e) {
              var acao = e.target.getAttribute && e.target.getAttribute('data-cookies');
              if (!acao) return;
              window.__cookies[acao]();
              aviso.hidden = true;
            });
            var abrir = document.querySelector('[data-abrir-cookies]');
            if (abrir) abrir.addEventListener('click', function () { aviso.hidden = false; aviso.querySelector('button').focus(); });
          })();
        </script>
      )
    }
  </body>
</html>
