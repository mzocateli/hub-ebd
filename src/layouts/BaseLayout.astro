---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descricao?: string;
  secao?: 'inicio' | 'series' | 'glossario' | 'busca';
  largo?: boolean;
}

const { titulo, descricao = 'Conteúdo das aulas da Escola Bíblica Dominical e glossário de termos.', secao, largo = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · EBD` : 'EBD · Aulas e glossário';
const atual = (s: Props['secao']) => (s === secao ? 'page' : undefined);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline>
      // Aplica o tema antes da pintura. data-theme = escolha explícita; data-theme-atual = tema em uso (para o ícone).
      (function () {
        var raiz = document.documentElement;
        var escolhido = null;
        try { escolhido = localStorage.getItem('tema'); } catch (e) {}
        if (escolhido === 'light' || escolhido === 'dark') raiz.dataset.theme = escolhido;
        var escuro = window.matchMedia('(prefers-color-scheme: dark)');
        function atualizar() { raiz.dataset.themeAtual = raiz.dataset.theme || (escuro.matches ? 'dark' : 'light'); }
        atualizar();
        escuro.addEventListener('change', atualizar);
        window.__alternarTema = function () {
          raiz.dataset.theme = raiz.dataset.themeAtual === 'dark' ? 'light' : 'dark';
          try { localStorage.setItem('tema', raiz.dataset.theme); } catch (e) {}
          atualizar();
        };
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container largo">
        <a class="marca" href={url('/')}>EBD <span>·</span> Aulas</a>
        <nav class="site-nav" aria-label="Principal">
          <a href={url('/')} aria-current={atual('inicio')}>Séries</a>
          <a href={url('/glossario/')} aria-current={atual('glossario')}>Glossário</a>
          <a href={url('/busca/')} aria-current={atual('busca')}>Buscar</a>
          <button class="tema" type="button" aria-label="Alternar tema claro ou escuro" title="Alternar tema claro ou escuro" onclick="window.__alternarTema()">
            <svg class="icone-lua" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icone-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <div class:list={['container', { largo }]}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container largo">
        Material de apoio da Escola Bíblica Dominical. Resumos para estudo pessoal. A Escritura é a única regra de fé e prática.
      </div>
    </footer>
  </body>
</html>
